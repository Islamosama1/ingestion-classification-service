# Copy to .env and replace every CHANGE_ME with the same password
# (letters and digits only, it goes inside URLs). Never commit .env.

NODE_ENV=development
PORT=3000

# Clients send this as the X-API-Key header (16+ chars). Set your own.
API_KEY=CHANGE_ME_TO_A_LONG_RANDOM_KEY

# Docker Compose PostgreSQL
POSTGRES_USER=ingestion
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_PORT=5432

# App DB (dev) and test DB (used by integration / API flow tests)
DATABASE_URL=postgres://ingestion:CHANGE_ME@localhost:5432/ingestion
TEST_DATABASE_URL=postgres://ingestion:CHANGE_ME@localhost:5432/ingestion_test
